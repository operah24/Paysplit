<div style="font-family: Arial, sans-serif; max-width: 600px; margin: auto; border: 1px solid #d8e7e5; padding: 24px; border-radius: 14px; background: #fbfefd;">
    <p style="color: #0f766e; text-align: center; font-size: 12px; letter-spacing: 2px; font-weight: bold; margin: 0 0 18px;">PAYSPLIT · SALARY AUTOPILOT</p>
    <h2 style="color: #102a43; text-align: center;"><%= heading %></h2>
    <p>Hello<%= firstName ? ` ${firstName}` : '' %>,</p>
    <p><%= intro %></p>
    <div style="font-size: 32px; font-weight: bold; text-align: center; letter-spacing: 5px; color: #0f766e; margin: 30px 0;">
        <%= otp %>
    </div>
    <p>This code will expire in <%= expiresInMinutes %> minutes. If you did not request this, please ignore this email.</p>
    <hr style="border: 0; border-top: 1px solid #eee; margin: 20px 0;">
    <p style="font-size: 12px; color: #6b7c93; text-align: center;">&copy; <%= new Date().getFullYear() %> PaySplit · Salary Autopilot.</p>
</div>
