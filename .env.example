# Application
PORT=3000
NODE_ENV=development
WEB_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=paysplit_db
# Set to true for managed databases that require TLS (RDS, Render, Neon, ...)
DB_SSL=false
# Log every SQL query to the console (very noisy — debugging only)
DB_LOGGING=false

# Logtail / BetterStack (optional)
BETTERSTACK_SOURCE_TOKEN=

# SMTP email (ZeptoMail). Leave SMTP_HOST/USER/PASS empty to log emails to the console.
# Port 587 uses STARTTLS; 465 uses implicit TLS.
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=587
SMTP_USER=emailapikey
SMTP_PASS=
# Sender address — must be on a domain verified in ZeptoMail.
SMTP_FROM=n
EMAIL_FROM_NAME=PaySplit | Salary Autopilot

KYC_PROVIDER=mock

# Security
ALLOWED_ORIGINS=*
# Required, min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_REMEMBER_ME_EXPIRES_IN=30d
JWT_SETUP_TOKEN_EXPIRES_IN=15m

# Dojah KYC (https://docs.dojah.io). Sandbox: https://sandbox.dojah.io, production: https://api.dojah.io
# The sandbox URL turns on KYC sandbox mode: the duplicate-ID check and selfie face match are
# skipped, because sandbox IDs are shared fakes with a stock photo. The server refuses to start
# with the sandbox URL when NODE_ENV=production, unless ALLOW_DOJAH_SANDBOX=true. The Docker image
# always sets NODE_ENV=production, so set ALLOW_DOJAH_SANDBOX=true on dev/staging Cloud Run
# services that use the sandbox. Never set it on the real production service.
ALLOW_DOJAH_SANDBOX=false
DOJAH_BASE_URL=https://sandbox.dojah.io
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_FACE_MATCH_THRESHOLD=90
DOJAH_LIVENESS_THRESHOLD=80
DOJAH_NAME_MATCH_THRESHOLD=80

# HePaid (payments). Use the SECRET key (hp_test_sk_... / hp_live_sk_...); the public key
# is not needed on the server. Test base URL (from the HePaid docs):
#   https://hepaid-be-dev-14573850302.europe-west1.run.app/v1
# Live: https://api.hepaid.com/v1 (production refuses to start with a test key).
HEPAID_BASE_URL=https://hepaid-be-dev-14573850302.europe-west1.run.app/v1
HEPAID_SECRET_KEY=
# Webhook signing secret (whsec_...) from the HePaid console: Products → Webhooks → endpoint.
# Shown once when the endpoint is added. Verifies the HePaid-Signature header.
HEPAID_WEBHOOK_SECRET=
# The Docker image always sets NODE_ENV=production, which requires a live key. On dev/staging
# Cloud Run services that use a test key, set ALLOW_HEPAID_TEST_KEY=true. Never on real production.
ALLOW_HEPAID_TEST_KEY=false
# Dev/QA only: POST /salary-account/simulate-credit + payouts settled without HePaid.
# Refused when NODE_ENV=production unless ALLOW_HEPAID_TEST_KEY=true.
PAYMENTS_SIMULATION=false
# Kobo held per beneficiary payout until HePaid reports the actual fee (5000 = ₦50).
HEPAID_TRANSFER_FEE_RESERVE=5000

# Background jobs (salary accounts, credit/payout sync every few minutes, nightly reconcile) run
# inside the app. On Cloud Run that needs CPU always allocated + min instances 1.
JOBS_SCHEDULER_ENABLED=true
# Optional: secret for POST /api/v1/internal/jobs/:name (X-Job-Secret) to run a job on demand.
# At least 32 characters; empty disables the endpoint. Generate: openssl rand -hex 32
JOBS_SECRET=

# Cloudinary (profile images). Keep the API secret server-side; never expose it to the client.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=paysplit

# KYC — required. AES-256 key for encrypting BVN/NIN at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KYC_ENCRYPTION_KEY=
KYC_MAX_IDENTITY_ATTEMPTS=3
KYC_MAX_LIVENESS_ATTEMPTS=5
